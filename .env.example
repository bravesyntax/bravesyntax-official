# Copy to .env.local for local development; set the same variables in Vercel → Project → Settings → Environment Variables.
# Never prefix secrets with NEXT_PUBLIC_ (those are exposed to the browser).

# Neon Postgres (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public site URL used for canonical links and emails (optional, defaults to https://bravesyntax.com)
NEXT_PUBLIC_SITE_URL=https://bravesyntax.com

# SMTP for all site email: enquiry alerts, auto-replies, application emails and ADMIN SIGN-IN CODES.
# Required in production: admin sign-in is two-step (password + emailed code) and is refused without SMTP_PASS.
# In local development the sign-in code is printed to the server console instead. Only SMTP_PASS is secret.
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bravesyntax@gmail.com
# SMTP_FROM=bravesyntax@gmail.com

# Cloudflare Turnstile captcha on the contact form. Enforced only when BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Admin panel session signing key (required for /admin). Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
ADMIN_SESSION_SECRET=

# Vercel Blob. A store is either public or private, so connect two stores to the project in Vercel:
# - a PUBLIC store with the default env prefix (BLOB) for blog/portfolio images uploaded in the admin;
# - a PRIVATE store with the env prefix RESUME_BLOB for career resumes (downloaded only via the admin).
# Without a token, that upload feature is hidden; existing data is unaffected.
BLOB_READ_WRITE_TOKEN=
RESUME_BLOB_READ_WRITE_TOKEN=

# Admin → GitHub Projects. Public repos need no setup; a read-only token adds private repos and a higher rate limit.
# GITHUB_USERNAME=bravesyntax
GITHUB_TOKEN=

# Website assistant (optional). A free Groq API key turns on the "Ask a question" tab.
# Create one at https://console.groq.com/keys; never commit the real value.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=  (preferred over Groq when set; free tier data may be used by Google)
# GEMINI_MODEL=gemini-flash-lite-latest
